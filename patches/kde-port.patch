diff --git a/eqsh/services/KdeToplevels.qml b/eqsh/services/KdeToplevels.qml
new file mode 100644
index 0000000..9addb13
--- /dev/null
+++ b/eqsh/services/KdeToplevels.qml
@@ -0,0 +1,149 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Quickshell.Wayland
+
+// Drop-in for ToplevelManager on KDE Plasma.
+// KWin exposes no wlr-foreign-toplevel, so window state comes from the revo KWin bridge
+// (~/revo-kde/kde-bridge): a KWin script pushes the window list to revo-kwin-bridge.py,
+// which writes $XDG_RUNTIME_DIR/revo-kwin/windows.json. Writes to minimized / maximized /
+// fullscreen and calls to activate() / close() are sent back through the bridge.
+// On any other compositor this just forwards ToplevelManager.
+Singleton {
+    id: root
+
+    readonly property bool isKde: (Quickshell.env("XDG_CURRENT_DESKTOP") ?? "").toUpperCase().indexOf("KDE") !== -1
+
+    readonly property var toplevels: isKde ? kdeModel : ToplevelManager.toplevels
+    readonly property var activeToplevel: isKde ? kdeModel.active : ToplevelManager.activeToplevel
+    readonly property string currentDesktop: kdeModel.currentDesktop
+    readonly property string activeScreen: kdeModel.activeScreen
+
+    // Screen the shell lives on (bar, dock, popups). Quickshell.screens[0] is just Qt's
+    // enumeration order, not the primary monitor: use $REVO_SCREEN if set, else KDE's
+    // primary output (kscreen priority 1), else the first screen.
+    property string primaryScreenName: Quickshell.env("REVO_SCREEN") ?? ""
+    readonly property var primaryScreen: Quickshell.screens.find(s => s.name === primaryScreenName) ?? Quickshell.screens[0]
+
+    Process {
+        running: root.isKde && !Quickshell.env("REVO_SCREEN")
+        command: ["kscreen-doctor", "-j"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const outs = JSON.parse(text).outputs.filter(o => o.enabled);
+                    const primary = outs.find(o => o.priority === 1) ?? outs[0];
+                    if (primary)
+                        root.primaryScreenName = primary.name;
+                } catch (e) {
+                    console.warn("KdeToplevels: kscreen-doctor:", e);
+                }
+            }
+        }
+    }
+
+    function send(id, verb) {
+        Quickshell.execDetached(["gdbus", "call", "--session", "--dest", "org.revo.KWinBridge",
+                                 "--object-path", "/", "--method", "org.revo.KWinBridge.action", id, verb]);
+    }
+
+    QtObject {
+        id: kdeModel
+        property var values: []
+        property var active: null
+        property string currentDesktop: ""
+        property string activeScreen: ""
+        property var byId: ({})
+    }
+
+    Component {
+        id: toplevelComp
+        QtObject {
+            id: tl
+            property string kwinId
+            property string appId
+            property string resourceClass
+            property string title
+            property int pid
+            property bool activated
+            property bool minimized
+            property bool maximized
+            property bool fullscreen
+            property string screenName
+            property var desktops: []
+            property bool onAllDesktops
+            // Hyprland-IPC shaped view, for code written against Hyprland.toplevels
+            readonly property string address: kwinId
+            readonly property var lastIpcObject: ({ address: kwinId, "class": resourceClass, initialClass: appId,
+                                                    title: title, initialTitle: title, pid: pid })
+            readonly property var screens: Quickshell.screens.filter(s => s.name === screenName)
+            property bool _syncing: false
+
+            function activate() { root.send(kwinId, "activate"); }
+            function close() { root.send(kwinId, "close"); }
+            function setMinimized(v) { root.send(kwinId, v ? "minimize" : "unminimize"); }
+            function setMaximized(v) { root.send(kwinId, v ? "maximize" : "unmaximize"); }
+            function setFullscreen(v) { root.send(kwinId, v ? "fullscreen" : "unfullscreen"); }
+
+            onMinimizedChanged: if (!_syncing) setMinimized(minimized)
+            onMaximizedChanged: if (!_syncing) setMaximized(maximized)
+            onFullscreenChanged: if (!_syncing) setFullscreen(fullscreen)
+        }
+    }
+
+    function apply(state) {
+        const seen = {};
+        const out = [];
+        const byId = kdeModel.byId;
+        for (const w of (state.windows ?? [])) {
+            let t = byId[w.id];
+            if (!t) {
+                t = toplevelComp.createObject(root, { kwinId: w.id });
+                byId[w.id] = t;
+            }
+            t._syncing = true;
+            t.appId = w.appId;
+            t.resourceClass = w.resourceClass;
+            t.title = w.title;
+            t.pid = w.pid;
+            t.activated = w.activated;
+            t.minimized = w.minimized;
+            t.maximized = w.maximized;
+            t.fullscreen = w.fullscreen;
+            t.screenName = w.screen;
+            t.desktops = w.desktops;
+            t.onAllDesktops = w.onAllDesktops;
+            t._syncing = false;
+            seen[w.id] = true;
+            out.push(t);
+        }
+        for (const id in byId) {
+            if (!seen[id]) {
+                byId[id].destroy();
+                delete byId[id];
+            }
+        }
+        kdeModel.values = out;
+        kdeModel.active = byId[state.activeId] ?? null;
+        kdeModel.currentDesktop = state.currentDesktop ?? "";
+        kdeModel.activeScreen = state.activeScreen ?? "";
+    }
+
+    FileView {
+        id: stateFile
+        path: root.isKde ? (Quickshell.env("XDG_RUNTIME_DIR") + "/revo-kwin/windows.json") : ""
+        watchChanges: true
+        printErrors: false
+        onFileChanged: reload()
+        onLoaded: {
+            try {
+                root.apply(JSON.parse(text()));
+            } catch (e) {
+                console.warn("KdeToplevels: bad state file:", e);
+            }
+        }
+    }
+}
