diff --git a/eqsh/ui/controls/windows/KdeGlassRegion.qml b/eqsh/ui/controls/windows/KdeGlassRegion.qml
new file mode 100644
index 0000000..a53b776
--- /dev/null
+++ b/eqsh/ui/controls/windows/KdeGlassRegion.qml
@@ -0,0 +1,49 @@
+import QtQuick
+import Quickshell
+
+// Blur region covering every visible glass item (revoGlass: true, e.g. BoxGlass) under
+// `scanRoot`, each with its own corner radius.
+// KDE stand-in for Hyprland's alpha-based layer blur ("blur on" + "ignore_alpha 0"):
+// KWin only blurs explicit ext-background-effect regions, which the Glass effect then
+// renders as refractive liquid glass. Call rebuild() whenever the content may have changed.
+Region {
+    id: region
+
+    property Item scanRoot: null
+    property bool active: true
+    property string _signature: ""
+
+    function _collect() {
+        const found = [];
+        const walk = it => {
+            for (const c of it.children) {
+                if (!c.visible || c.opacity <= 0.01)
+                    continue;
+                if (c.revoGlass === true)
+                    found.push(c);
+                else
+                    walk(c);
+            }
+        };
+        if (active && scanRoot)
+            walk(scanRoot);
+        return found;
+    }
+
+    function rebuild() {
+        const found = _collect();
+        const sig = found.map(it => String(it)).join("|");
+        if (sig === _signature)
+            return;
+        _signature = sig;
+        const old = Array.from(region.regions);
+        region.regions = found.map(it => {
+            const r = Qt.createQmlObject("import Quickshell; Region {}", region);
+            r.item = it;
+            r.radius = Qt.binding(() => Math.round(it.radius ?? 0));
+            return r;
+        });
+        for (const r of old)
+            r.destroy();
+    }
+}
